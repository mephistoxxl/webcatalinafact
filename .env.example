# Copy this file to .env.local and fill in real values.
# Never prefix Payphone secrets with NEXT_PUBLIC_.

# Existing email configuration
ZEPTO_HOST=
ZEPTO_PORT=587
ZEPTO_USER=
ZEPTO_PASS=
ZEPTO_FROM=
ZEPTO_TO=

# Payphone server-side configuration
PAYPHONE_API_URL=https://pay.payphonetodoesposible.com/api
PAYPHONE_IDENTIFIER=
PAYPHONE_CLIENT_ID=
PAYPHONE_CLIENT_SECRET=
PAYPHONE_ENCODING_PASSWORD=
PAYPHONE_TOKEN=
PAYPHONE_RETURN_URL=http://localhost:3000/pago/resultado
PAYPHONE_CANCEL_URL=http://localhost:3000/precios